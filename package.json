{
  "name": "backendmasters",
  "private": true,
  "description": "BackendMasters: Learn. Build. Design. Scale.",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@backendmasters/web",
    "dev:api": "turbo run dev --filter=@backendmasters/api",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "check": "turbo run typecheck lint test build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local --schema public > apps/api/src/supabase/database.types.ts",
    "test:db": "npm run test:db --workspace @backendmasters/api"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "typescript": "~6.0.2",
    "prettier": "^3.4.2",
    "supabase": "^3.0.0"
  }
}
