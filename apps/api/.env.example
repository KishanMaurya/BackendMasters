# Copy to .env. The API starts without Supabase in development; /health then reports "not_configured".
# All three SUPABASE_* values are required when NODE_ENV=production.

NODE_ENV=development
PORT=4000

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000

# Defaults to on outside production, off in production.
# SWAGGER_ENABLED=

# Supabase dashboard > Project Settings > API Keys.
SUPABASE_URL=
# Publishable key (sb_publishable_...), or the legacy anon key.
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...), or the legacy service_role key.
# Bypasses Row Level Security. Server-only: never put it in the web app or commit it.
SUPABASE_SECRET_KEY=

# Tells the website to refresh after content changes. Required when NODE_ENV=production.
# Without these locally, saves still work and the site refreshes hourly.
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
# A long random value, the same one set in the web app. Generate with: openssl rand -hex 32
REVALIDATE_SECRET=
