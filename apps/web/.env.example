# Copy to .env.local. These are safe defaults for local development.

# Server-side URL of the NestJS API. Never exposed to the browser.
API_URL=http://localhost:4000/api/v1

# Public site URL. Goes into canonical addresses, the sitemap and structured data.
# Production: https://backendmasters.in
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin sign-in and article images. Supabase dashboard > Project Settings > API Keys.
# Only the publishable key belongs here. NEVER put the secret or service-role key in this app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Lets the API refresh the site when content changes. The same value as in the API's .env.
# Generate with: openssl rand -hex 32
REVALIDATE_SECRET=
